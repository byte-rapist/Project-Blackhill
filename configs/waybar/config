{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/security", "network", "cpu", "memory", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    },

    "custom/security": {
        "exec": "~/.config/waybar/scripts/security-status.sh",
        "interval": 30,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "ETH",
        "format-disconnected": "OFFLINE"
    },

    "cpu": {
        "format": "CPU {usage}%"
    },

    "memory": {
        "format": "MEM {percentage}%"
    },

    "battery": {
        "format": "{capacity}%",
        "format-charging": "{capacity}%+"
    },

    "tray": {
        "spacing": 8
    }
}
